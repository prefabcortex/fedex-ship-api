{
    "name": "prefabcortex/fedex-ship-api",
    "description": "Unofficial PHP client for Ship API",
    "type": "library",
    "keywords": [
        "openapi",
        "api-client",
        "rest",
        "sdk",
        "fedex",
        "ship"
    ],
    "homepage": "https://github.com/prefabcortex/fedex-ship-api",
    "license": "0BSD",
    "authors": [
        {
            "name": "Dominic Bla\u00df"
        }
    ],
    "support": {
        "issues": "https://github.com/prefabcortex/fedex-ship-api/issues",
        "source": "https://github.com/prefabcortex/fedex-ship-api"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "nyholm/psr7": "^1.8.2",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.0 || ^2.0",
        "symfony/validator": "^7.4 || ^8.0"
    },
    "conflict": {
        "symfony/translation-contracts": "<3.5"
    },
    "autoload": {
        "psr-4": {
            "Prefabcortex\\FedexShipApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Prefabcortex\\FedexShipApi\\Examples\\": "examples/",
            "Prefabcortex\\FedexShipApi\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "ergebnis/phpstan-rules": "^2.14",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "psr/log": "^3.0",
        "roave/backward-compatibility-check": "^8.22",
        "shipmonk/phpstan-rules": "^4.4",
        "symfony/http-client": "^7.4 || ^8.0"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=-1",
        "cs-check": "php-cs-fixer check",
        "cs-fix": "php-cs-fixer fix",
        "bc-check": "roave-backward-compatibility-check"
    }
}
